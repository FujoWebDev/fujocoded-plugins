{
  "name": "fujocoded-plugins",
  "private": true,
  "workspaces": [
    "*/",
    "!.*/",
    "astro-*/__example__",
    "astro-*/example",
    "astro-ao3-loader/__examples__/*",
    "astro-authproto/__examples__/*",
    "astro-smooth-actions/__examples__/astro-5",
    "remark-*/__example__",
    "zod-transform-socials/__examples__/01-astro-5-loader"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck typecheck:examples",
    "release": "npm run build && changeset publish --provenance",
    "sherif": "npx sherif@latest --ignore-rule non-existant-packages --fail-on-warnings",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "lint:ci": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt && prettier --write \"**/*.astro\"",
    "format:check": "oxfmt --check && prettier --check \"**/*.astro\"",
    "check": "npm run format:check && npm run lint:ci && npm run sherif && npm run typecheck && npm run test && npm run build",
    "fix": "npm run format && npm run lint:fix"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.29.8",
    "@changesets/parse": "^0.4.3",
    "@clack/prompts": "^1.7.0",
    "@manypkg/get-packages": "^1.1.3",
    "@types/node": "^24.19.1",
    "commander": "^15.0.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.22.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  },
  "packageManager": "npm@11.5.1"
}
